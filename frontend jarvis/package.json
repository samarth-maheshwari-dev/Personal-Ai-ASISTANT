{
  "name": "frontend-jarvis",
  "private": true,
  "version": "0.1.0",
  "main": "main.js",
  "build": {
    "appId": "com.jarvis.app",
    "productName": "JARVIS",
    "directories": {
      "output": "dist-win"
    },
    "win": {
      "target": "portable",
      "icon": "public/vite.svg"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "package.json"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "start": "node backend/server.js",
    "electron": "electron .",
    "build:win": "electron-builder --win"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "electron": "^30.0.0",
    "express": "^4.18.2",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sqlite3": "^5.1.6",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "electron-builder": "^24.6.3",
    "nodemon": "^3.0.3",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.0"
  }
}